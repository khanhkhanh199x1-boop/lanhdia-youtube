{
  "manifest_version": 3,
  "name": "LÃNH ĐỊA YOUTUBE · Đồng bộ kênh",
  "version": "2.0.0",
  "description": "Đồng bộ kênh từ YouTube Studio và mở đúng hồ sơ Chrome đã ghép trên Windows.",
  "incognito": "not_allowed",
  "minimum_chrome_version": "115",
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      }
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "Đồng bộ kênh với LÃNH ĐỊA YOUTUBE",
    "default_icon": "icon.png"
  },
  "key": "",
  "background": {
    "service_worker": "worker.js"
  },
  "externally_connectable": {
    "matches": [
      "https://lanhdiayoutube2027-beryl.vercel.app/*"
    ]
  }
}
