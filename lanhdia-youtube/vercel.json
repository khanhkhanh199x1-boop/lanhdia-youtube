{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "src/lib/server-http.ts,src/lib/rbac.ts,src/lib/firebase-admin.ts,src/lib/channel-meta-api.ts,src/lib/channel-entries.ts,src/lib/team-api.ts,src/lib/plans.ts,src/lib/sheet-parser.ts,src/lib/helper-package.ts,package.json"
    }
  }
}
