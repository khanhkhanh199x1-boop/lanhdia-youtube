FIREBASE_SERVICE_ACCOUNT_KEY=
MASTER_ADMIN_UID=ZLf8yirSASXNMFzTK8VH255dYeD3

# Cấu hình nhận tiền VietQR (có thể cấu hình trong tab "Cấu hình VietQR" của Admin)
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# Port khi chạy server local (npm run start)
PORT=3000

# Tùy chọn: khóa YouTube Data API v3 phía server, không dùng tiền tố VITE_.
YOUTUBE_DATA_API_KEY=
