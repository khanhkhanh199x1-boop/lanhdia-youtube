VITE_FIREBASE_PROJECT_ID=gemini-ai-tuchay
VITE_FIREBASE_STORAGE_BUCKET=gemini-ai-tuchay.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ===== Backend (KHÔNG tiền tố VITE_) =====
